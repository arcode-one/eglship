# Production origin without a trailing slash. For a project GitHub Pages site,
# include the repository path: https://username.github.io/repository
NEXT_PUBLIC_SITE_URL=https://eglship.com

# Leave empty for a custom domain or username.github.io root site.
NEXT_PUBLIC_BASE_PATH=

# Optional ownership-verification tokens from search-engine webmaster panels.
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
